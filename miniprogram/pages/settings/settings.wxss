/* pages/settings/settings.wxss */
.settings-page {
  padding: 32rpx;
  background-color: #F7F8FA;
  min-height: 100vh;
}

.settings-group {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.group-title {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #888888;
  border-bottom: 1rpx solid #F7F8FA;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F7F8FA;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #333333;
}

.setting-label.logout {
  color: #FF4D4F;
}

.setting-value {
  font-size: 28rpx;
  color: #888888;
}

.setting-input {
  width: 100rpx;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
}

.version-info {
  text-align: center;
  padding: 60rpx;
  font-size: 24rpx;
  color: #CCCCCC;
}
