/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #E8F8F2 0%, #F7F8FA 100%);
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #888888;
}

/* 登录方式 */
.login-methods {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-wechat {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #07C160;
  color: #FFFFFF;
  border-radius: 100rpx;
  padding: 28rpx 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.btn-wechat .icon {
  margin-right: 16rpx;
  font-size: 40rpx;
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0;
}

.divider .line {
  flex: 1;
  height: 1rpx;
  background-color: #EEEEEE;
}

.divider .text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 手机号登录 */
.phone-login {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.phone-input,
.code-input {
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.code-input-wrapper {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
}

.btn-code {
  background-color: #00D084;
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  font-size: 24rpx;
  font-weight: bold;
  border: none;
  min-width: 180rpx;
}

.btn-code.disabled {
  background-color: #CCCCCC;
}

.btn-phone-login {
  background-color: #00D084;
  color: #FFFFFF;
  border-radius: 100rpx;
  padding: 28rpx 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  margin-top: 24rpx;
}

/* 用户协议 */
.agreement {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.agreement-label {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  color: #888888;
}

.agreement-text {
  line-height: 1.6;
  margin-left: 12rpx;
}

.agreement-text .link {
  color: #00D084;
}
