/* pages/course-detail/course-detail.wxss */
.course-detail {
  min-height: 100vh;
  background-color: #FFFFFF;
}

/* 封面 */
.cover-section {
  height: 440rpx;
  background-size: cover;
  background-position: center;
  position: relative;
}

.cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.6) 100%);
}

.nav-bar {
  display: flex;
  justify-content: space-between;
  padding: 88rpx 32rpx 32rpx;
  color: #FFFFFF;
  font-size: 40rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #FFFFFF;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  margin-top: -48rpx;
  padding: 48rpx 32rpx;
  min-height: calc(100vh - 392rpx);
}

.course-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.course-stats {
  display: flex;
  gap: 16rpx;
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 32rpx;
}

.course-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

/* 训练大纲 */
.outline-section {
  margin-top: 48rpx;
}

.outline-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.outline-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.outline-progress {
  font-size: 24rpx;
  color: #888888;
}

.sentences-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.sentence-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
}

.sentence-item.completed {
  background-color: #E8F8F2;
}

.sentence-item.locked {
  opacity: 0.5;
}

.sentence-index {
  width: 56rpx;
  height: 56rpx;
  background-color: #00D084;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.sentence-item.completed .sentence-index {
  background-color: #00A368;
}

.sentence-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sentence-play {
  width: 48rpx;
  height: 48rpx;
  background-color: #00D084;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  margin-left: 16rpx;
}

/* 底部按钮 */
.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.05);
}

.btn-primary {
  background-color: #00D084;
  color: #FFFFFF;
  border: none;
  padding: 32rpx;
  border-radius: 100rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 208, 132, 0.3);
}
