/* pages/index/index.wxss */
.container {
  padding: 40rpx 32rpx;
}

.header {
  margin-bottom: 40rpx;
}

.greeting {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 8rpx;
}

.username {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #888888;
}
